              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/books"
          }
        },
        {
          "name": "Update book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().author).to.eql('Alibou 2');",
                  "  pm.expect(pm.response.json().createdBy).to.not.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
