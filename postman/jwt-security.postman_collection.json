            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Ali\",\n  \"lastname\": \"Admin\",\n  \"email\": \"admin@mail.com\",\n  \"password\": \"password\",\n  \"role\": \"ADMIN\"\n}"
